{
  "name": "psr-tracker-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop shell for the PSR Tracker web app - opens the centrally-hosted deployment in a native window.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.surabhik7.psrtracker",
    "productName": "PSR Tracker",
    "files": ["main.js"],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    }
  }
}
