# Copy this file to server/.env and fill in the values for your environment.

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/vista

# Port the API server listens on
PORT=5000

# URL of the client app (for CORS)
CLIENT_URL=http://localhost:5173

# --- Automated Email (Microsoft Graph / Azure AD) ---
# Leave these blank until an Azure AD app registration is available. Until all four
# are set, VISTA falls back to opening a pre-filled draft in the local desktop Outlook
# app instead of sending automatically.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SENDER_EMAIL=
